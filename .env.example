# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
REPOPULSE_API_KEY=
# Optional pair; omit both for organization-only cards.
GITHUB_PERSONAL_OWNER=
GITHUB_PERSONAL_TOKEN=
# Configure at least one complete pair. Use your organization's actual GitHub login.
GITHUB_ORG_OWNER=
GITHUB_ORG_TOKEN=
# Selected repositories only; max 12. All owners must have configured credentials.
REPOPULSE_REPOSITORIES='[{"repository":"your-login/private-project","description":"Developer tools"}]'
# Enabling this publishes ALL configured rows and their metadata. JSON stays protected.
REPOPULSE_PUBLISH_ACTIVITY=false
REPOPULSE_TITLE=Private activity
REPOPULSE_ABOUT=A snapshot of the projects I am building.
REPOPULSE_THEME=dark
PORT=3000
