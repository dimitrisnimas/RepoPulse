NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_VERSION=0.4.0
GITHUB_TOKEN=
# Fine-grained token scoped only to explicitly selected private repositories.
REPOPULSE_PRIVATE_GITHUB_TOKEN=
# Comma-separated owner/repository allowlist; maximum 12 entries.
REPOPULSE_PRIVATE_REPOSITORIES=dimitrisnimas/private-repo-one,dimitrisnimas/private-repo-two
REPOPULSE_PRIVATE_ABOUT_TEXT=Building private products, APIs and developer tools with a focus on reliability and performance.
# Pipe-separated repository:public description entries. Keep descriptions non-sensitive.
REPOPULSE_PRIVATE_REPOSITORY_DESCRIPTIONS=ecos.identity:Authentication in .NET & account management in TypeScript|ecos.notification:Centralized notifications and multi-channel message delivery|ecos.billing:Billing, payments, invoices and subscription lifecycle management|ecos.sepam:Central member and subscription management for nonprofit organizations|repopulse:GitHub metrics, profile cards and developer activity insights|status-health-monitor:Uptime, service health and incident visibility|ecos.nexus:Central integration hub connecting ecosystem services and workflows
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
CRON_SECRET=replace-with-at-least-16-random-characters
REPOPULSE_CACHE_TTL_SECONDS=3600
REPOPULSE_STALE_TTL_SECONDS=86400
REPOPULSE_RATE_LIMIT_REQUESTS=60
REPOPULSE_RATE_LIMIT_WINDOW_SECONDS=60
REPOPULSE_GITHUB_TIMEOUT_MS=6000
REPOPULSE_GITHUB_MAX_RETRIES=2
REPOPULSE_GITHUB_RETRY_BASE_DELAY_MS=250
REPOPULSE_CIRCUIT_FAILURE_THRESHOLD=5
REPOPULSE_CIRCUIT_COOLDOWN_SECONDS=60
REPOPULSE_DISTRIBUTED_LOCK_TTL_SECONDS=15
REPOPULSE_DEDUPLICATION_WAIT_MS=1500
REPOPULSE_REFRESH_MAX_ENTRIES=25
